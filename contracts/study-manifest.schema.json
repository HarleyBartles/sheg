{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "study": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "purpose"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f\\d]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "instructions",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "expose"
              },
              "itemId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "id",
              "kind",
              "itemId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "decide"
              },
              "decisionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "id",
              "kind",
              "decisionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "terminal"
              },
              "outcome": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "id",
              "kind",
              "outcome"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "transitions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromNodeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "choice": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "toNodeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "fromNodeId",
          "toNodeId"
        ],
        "additionalProperties": false
      }
    },
    "entryNodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "maxDecisions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "study",
    "sources",
    "items",
    "decisions",
    "nodes",
    "transitions",
    "entryNodeId",
    "maxDecisions"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.system-one-polling.dev/study-manifest.schema.json",
  "title": "Study manifest",
  "x-validation-rules": [
    "Text fields must contain non-whitespace content; surrounding whitespace is trimmed by runtime validation.",
    "Item, decision, and node IDs are unique across the manifest.",
    "The entry node and every node reference resolve.",
    "Terminal nodes have no outgoing transitions.",
    "Exposure nodes have exactly one unconditional transition.",
    "Decision nodes have exactly one transition for every offered choice and no others.",
    "Every node is reachable from the entry node.",
    "Total exposed stimulus text is at most 80 KB."
  ]
}
