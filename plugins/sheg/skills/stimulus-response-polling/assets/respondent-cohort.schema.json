{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0"
    },
    "archetypes": {
      "$ref": "urn:sheg:schema:respondent-archetype-library.schema.json"
    },
    "respondents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "urn:sheg:schema:respondent-profile.schema.json"
      }
    },
    "admission": {
      "type": "object",
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "frozenAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "rationale",
        "frozenAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "respondents"
  ],
  "additionalProperties": false,
  "$id": "urn:sheg:schema:respondent-cohort.schema.json",
  "title": "Frozen respondent cohort",
  "x-validation-rules": [
    "Respondent IDs are unique within the cohort.",
    "Every archetypeId refers to an archetype included in the cohort snapshot.",
    "Archetype-derived respondents select exactly one declared value for every variation axis."
  ]
}
