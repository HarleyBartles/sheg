{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "assetId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "maxWidth": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxHeight": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "source"
  ],
  "additionalProperties": false,
  "$id": "urn:sheg:schema:image-scale-request.schema.json",
  "title": "Sheg image scale request",
  "x-validation-rules": [
    "A file source includes its expected SHA-256 digest; saved asset references use Sheg custody.",
    "maxBytes constrains only the prepared image bytes and does not guarantee inference context fit.",
    "Scaling preserves format and image content with proportional dimensions; it does not crop or tune quality."
  ]
}
