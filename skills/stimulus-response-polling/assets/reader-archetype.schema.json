{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "arrival_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "desired_payoff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "drawn_in_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "put_off_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "invariants": {
      "minItems": 2,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "variation_axes": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "values": {
            "minItems": 2,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "id",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "description",
          "values"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "arrival_intent",
    "background",
    "desired_payoff",
    "drawn_in_by",
    "put_off_by",
    "invariants",
    "variation_axes"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.system-one-polling.dev/reader-archetype.schema.json",
  "title": "Reader archetype"
}
