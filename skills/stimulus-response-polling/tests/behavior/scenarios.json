      },
      "questions": {
        "Q1": "Would you keep reading?",
        "Q2": "How clearly does B follow the promise in A?",
        "Q3": "Does the later evidence change your view of A?",
        "Q4": "Why did you stop?"
      },
      "mockOnly": true
    }
